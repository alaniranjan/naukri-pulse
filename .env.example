# Copy this file to .env and fill in the values.  (.env is git-ignored.)

# Telegram bot token from @BotFather
TG_TOKEN=

# Your personal Telegram chat ID (a number)
TG_CHAT=

# false = you see the browser (laptop). true = no window (Render / servers).
HEADLESS=false

# Leave EMPTY on your laptop: the script then uses the local naukri-session.json file.
# On Render, put the base64 text of naukri-session.json here.
NAUKRI_SESSION_B64=

# Port for the local dashboard (npm run dashboard)
DASHBOARD_PORT=3100
